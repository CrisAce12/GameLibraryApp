<Window x:Class="GameLibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Library" 
        Height="700" Width="1150"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#D0D0D0">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- ========================================== -->
        <!-- VIEW 1: MAIN LIBRARY GRID VIEW (RESPONSIVE)-->
        <!-- ========================================== -->
        <Grid Visibility="{Binding IsGridOpen, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Black Sidebar -->
            <Grid Grid.Column="0" Background="#000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Tree Asset Placeholder -->
                <TextBlock Grid.Row="0" Text="🎕" Foreground="White" FontSize="48" Margin="20,10,0,0" VerticalAlignment="Top"/>

                <!-- Controls & Branding Panel -->
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="20,0,20,30">
                    <!-- Cover Resize Slider -->
                    <TextBlock Text="COVER SIZE" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Slider Value="{Binding CoverWidth}" Minimum="100" Maximum="260" Margin="0,0,0,20" Cursor="Hand"/>

                    <!-- Add Game Button -->
                    <Button Command="{Binding OpenAddGameCommand}" 
                            Content="+ Add Game" 
                            Foreground="Black" Background="White" 
                            FontWeight="Bold" FontSize="14" Padding="10,8" Margin="0,0,0,25" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="VIDEOGAMES" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="LIBRARY" Foreground="White" FontSize="22" FontWeight="Black"/>
                </StackPanel>
            </Grid>

            <!-- Main Game Grid Scrollable Area -->
            <Grid Grid.Column="1" Background="#FFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Margin="12" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" Background="White">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Color="Black" Opacity="0.4"/>
                                                </Border.Effect>
                                                <Image Source="{Binding CoverImagePath}" 
                                                       Width="{Binding DataContext.CoverWidth, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                       Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- VIEW 2: GAME DETAIL INSPECTOR (RESPONSIVE) -->
        <!-- ========================================== -->
        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="7*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>

            <!-- Top White Section -->
            <Grid Grid.Row="0" Background="#FFFFFF">
                <Button Command="{Binding CloseDetailCommand}" 
                        Content="←" FontSize="28" FontWeight="Bold" Foreground="Black"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" 
                        Margin="25,20,0,0" Cursor="Hand"/>

                <!-- Top Right Management Icons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,25,0">
                    <Button Command="{Binding OpenEditGameCommand}" ToolTip="Edit Game"
                            Content="✎" FontSize="20" FontWeight="Bold" Foreground="White" Background="Black"
                            Width="40" Height="40" Margin="0,0,12,0" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Command="{Binding DeleteGameCommand}" ToolTip="Delete Game"
                            Content="🗑" FontSize="18" Foreground="Black" Background="Transparent"
                            Width="40" Height="40" BorderBrush="Black" BorderThickness="2" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Bottom Black Banner -->
            <Grid Grid.Row="1" Background="#000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding SelectedGame.Title}" 
                           Foreground="White" FontSize="38" FontWeight="Black" 
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Center" 
                           Margin="20,0,30,0"/>

                <Button Grid.Column="1" Command="{Binding LaunchGameCommand}" Content="►  Jugar" 
                        Foreground="Black" Background="White" FontSize="16" FontWeight="Bold"
                        Padding="30,12" Margin="0,0,50,0" VerticalAlignment="Center" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="24"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Responsive Overlapping Cover Image Container -->
            <Border Grid.RowSpan="2" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    Margin="60,20,20,20" 
                    MaxWidth="450" 
                    MaxHeight="580">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="12" Direction="270" Color="Black" Opacity="0.55"/>
                </Border.Effect>
                <Image Source="{Binding SelectedGame.CoverImagePath}" 
                       Stretch="Uniform"/>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- VIEW 3: ADD GAME MODAL (RESPONSIVE)        -->
        <!-- ========================================== -->
        <Grid Visibility="{Binding IsAddGameOpen, Converter={StaticResource BoolToVis}}" Background="#B0000000">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#1E1E1E" Width="460" MaxWidth="520" Padding="25" CornerRadius="8" Margin="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Color="Black" Opacity="0.8"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Add New Game" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Title" Foreground="#AAAAAA" Margin="0,5,0,3"/>
                        <TextBox Text="{Binding NewGameTitle, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="8" Background="#2D2D2D" Foreground="White" BorderThickness="1" BorderBrush="#444444" Margin="0,0,0,10"/>

                        <TextBlock Text="Cover Image Path or URL" Foreground="#AAAAAA" Margin="0,5,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewGameCoverPath, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8" Background="#2D2D2D" Foreground="White" BorderThickness="1" BorderBrush="#444444"/>
                            <Button Grid.Column="1" Command="{Binding BrowseCoverCommand}" Content="Browse..." 
                                    Padding="12,0" Margin="8,0,0,0" Background="#3E3E3E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Executable Path or Launch URI (e.g., steam://...)" Foreground="#AAAAAA" Margin="0,5,0,3"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewGameExePath, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8" Background="#2D2D2D" Foreground="White" BorderThickness="1" BorderBrush="#444444"/>
                            <Button Grid.Column="1" Command="{Binding BrowseExeCommand}" Content="Browse..." 
                                    Padding="12,0" Margin="8,0,0,0" Background="#3E3E3E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelAddGameCommand}" Content="Cancel" 
                                    Padding="15,8" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                            <Button Command="{Binding SaveGameCommand}" Content="Save Game" 
                                    Padding="20,8" Background="White" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- ========================================== -->
        <!-- VIEW 4: EDIT GAME MODAL (RESPONSIVE)       -->
        <!-- ========================================== -->
        <Grid Visibility="{Binding IsEditGameOpen, Converter={StaticResource BoolToVis}}" Background="#B0000000">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#1E1E1E" Width="460" MaxWidth="520" Padding="25" CornerRadius="8" Margin="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Color="Black" Opacity="0.8"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Edit Game Details" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Title" Foreground="#AAAAAA" Margin="0,5,0,3"/>
                        <TextBox Text="{Binding EditGameTitle, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="8" Background="#2D2D2D" Foreground="White" BorderThickness="1" BorderBrush="#444444" Margin="0,0,0,10"/>

                        <TextBlock Text="Cover Image Path or URL" Foreground="#AAAAAA" Margin="0,5,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EditGameCoverPath, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8" Background="#2D2D2D" Foreground="White" BorderThickness="1" BorderBrush="#444444"/>
                            <Button Grid.Column="1" Command="{Binding BrowseEditCoverCommand}" Content="Browse..." 
                                    Padding="12,0" Margin="8,0,0,0" Background="#3E3E3E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Executable Path or Launch URI" Foreground="#AAAAAA" Margin="0,5,0,3"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EditGameExePath, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8" Background="#2D2D2D" Foreground="White" BorderThickness="1" BorderBrush="#444444"/>
                            <Button Grid.Column="1" Command="{Binding BrowseEditExeCommand}" Content="Browse..." 
                                    Padding="12,0" Margin="8,0,0,0" Background="#3E3E3E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelEditGameCommand}" Content="Cancel" 
                                    Padding="15,8" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                            <Button Command="{Binding SaveEditGameCommand}" Content="Save Changes" 
                                    Padding="20,8" Background="White" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>